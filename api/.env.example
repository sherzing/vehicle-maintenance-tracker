# Required
FIREBASE_PROJECT_ID=maintainer-dev

# Optional (defaults shown)
PORT=8080
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/vmt
LOG_LEVEL=info
RATE_LIMIT_RPM=60
CORS_ORIGINS=*

# AWS (only if DB_DRIVER=dynamo)
# AWS_REGION=us-east-1
# DYNAMO_TABLE_PREFIX=vmt_

# GCP (only if DB_DRIVER=firestore)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
