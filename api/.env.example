# Required (unless AUTH_DISABLED=true)
FIREBASE_PROJECT_ID=maintainer-dev

# Optional (defaults shown)
PORT=8080
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/vmt
LOG_LEVEL=info
RATE_LIMIT_RPM=60
CORS_ORIGINS=*

# Local dev mode — skips Firebase JWT verification, injects a fake user
# AUTH_DISABLED=true
# DEV_USER_ID=dev-user-1

# Firestore storage backend (DB_DRIVER=firestore)
# Uses Firestore REST API directly — no GCP SDK needed.
# Requires FIREBASE_PROJECT_ID (set above).
# FIRESTORE_TOKEN=           # OAuth2 token, or leave empty for ADC (gcloud auth application-default login)

# S3 storage backend (DB_DRIVER=s3)
# Stores each collection as a JSON file in S3. Best for Lambda deployments
# with mobile apps that cache locally — near-zero cost, ~100-300ms latency.
# S3_BUCKET=my-vmt-bucket
# S3_PREFIX=vmt/
# AWS_REGION=us-east-1

# AWS DynamoDB (only if DB_DRIVER=dynamo)
# AWS_REGION=us-east-1
# DYNAMO_TABLE_PREFIX=vmt_

# GCP (only if DB_DRIVER=firestore)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
