{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "firebase": "firebase",
    "deploy:dev": "npm run test:all && npm run build:dev && firebase deploy --only hosting -P dev",
    "deploy:dev:all": "npm run test:all && npm run build:dev && firebase deploy -P dev",
    "deploy:dev:rules": "firebase deploy --only firestore:rules -P dev",
    "deploy:prod": "npm run test:all && npm run build:prod && firebase deploy --only hosting -P prod",
    "deploy:prod:all": "npm run test:all && npm run build:prod && firebase deploy -P prod",
    "deploy:prod:rules": "firebase deploy --only firestore:rules -P prod",
    "deploy": "npm run deploy:dev",
    "emulators": "firebase emulators:start",
    "reset-db-dev": "node scripts/reset-db.js",
    "seed-db-dev": "node scripts/seed-db.js",
    "capture-mockups": "node mockups/dark/capture-screenshots.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^12.7.0",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.0.2",
    "firebase-tools": "^15.1.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
