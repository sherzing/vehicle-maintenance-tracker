rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isTeamMember(teamId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.member_ids;
    }

    function isTeamOwner(teamId) {
      return isAuthenticated() &&
             request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.owner_id;
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own user document
      allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // Teams collection
    match /teams/{teamId} {
      // Helper function to validate team update data
      function isValidTeamUpdate() {
        // Ensure owner_id cannot be changed
        let ownerUnchanged = !request.resource.data.keys().hasAny(['owner_id']) ||
                             request.resource.data.owner_id == resource.data.owner_id;

        // Ensure owner is always in member_ids
        let ownerInMembers = request.resource.data.owner_id in request.resource.data.member_ids;

        // Ensure member_ids is an array
        let memberIdsIsArray = request.resource.data.member_ids is list;

        // Ensure member_ids are all strings
        let memberIdsAreStrings = request.resource.data.member_ids.hasOnly([]) ||
                                   request.resource.data.member_ids[0] is string;

        return ownerUnchanged && ownerInMembers && memberIdsIsArray && memberIdsAreStrings;
      }

      // Any authenticated user can create a team
      allow create: if isAuthenticated() &&
                      request.resource.data.owner_id == request.auth.uid &&
                      request.auth.uid in request.resource.data.member_ids &&
                      request.resource.data.member_ids is list;

      // Users can read teams they're members of
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.member_ids;

      // Only team owners can update teams, with validation
      allow update: if isAuthenticated() &&
                      isTeamOwner(teamId) &&
                      isValidTeamUpdate();

      // Only team owners can delete teams
      allow delete: if isAuthenticated() && isTeamOwner(teamId);
    }

    // Vehicles collection (for future implementation)
    match /vehicles/{vehicleId} {
      // Users can read vehicles in their teams
      allow read: if isAuthenticated() && isTeamMember(resource.data.team_id);

      // Users can create vehicles in their teams
      allow create: if isAuthenticated() && isTeamMember(request.resource.data.team_id);

      // Users can update/delete vehicles in their teams
      allow update, delete: if isAuthenticated() && isTeamMember(resource.data.team_id);
    }

    // Maintenance items collection (for future implementation)
    match /maintenance_items/{itemId} {
      // Users can access maintenance items for vehicles in their teams
      allow read: if isAuthenticated() &&
                    isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);

      allow create: if isAuthenticated() &&
                      isTeamMember(get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicle_id)).data.team_id);

      allow update, delete: if isAuthenticated() &&
                              isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);
    }

    // Service history collection (supports both scheduled services and ad-hoc repairs)
    match /service_history/{historyId} {
      // Users can access service history for vehicles in their teams
      allow read: if isAuthenticated() &&
                    isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);

      // Users can create service/repair entries with valid type
      allow create: if isAuthenticated() &&
                      isTeamMember(get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicle_id)).data.team_id) &&
                      request.resource.data.type in ['service', 'repair'];

      // Users can update/delete service history in their teams
      allow update, delete: if isAuthenticated() &&
                              isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);
    }

    // Usage history collection
    match /usage_history/{historyId} {
      // Helper function to validate usage history data
      function isValidUsageData(data) {
        return data.vehicle_id is string &&
               data.vehicle_id.size() > 0 &&
               data.vehicle_id.size() <= 1500 &&
               data.usage is number &&
               data.usage >= 0 &&
               data.usage < 10000000 &&
               data.date is timestamp &&
               data.date <= request.time &&
               (data.usage_type == null || (data.usage_type is string && data.usage_type.size() <= 500)) &&
               (data.location == null || (data.location is string && data.location.size() <= 500)) &&
               data.created_by is string &&
               data.created_at is timestamp &&
               (data.updated_at == null || data.updated_at is timestamp) &&
               (data.updated_by == null || data.updated_by is string) &&
               data.version is int &&
               data.version >= 1 &&
               data.version < 1000000;
      }

      // Users can access usage history for vehicles in their teams
      allow read: if isAuthenticated() &&
                    isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);

      // Users can create usage entries with proper validation
      allow create: if isAuthenticated() &&
                      isTeamMember(get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicle_id)).data.team_id) &&
                      request.resource.data.created_by == request.auth.uid &&
                      request.resource.data.version == 1 &&
                      isValidUsageData(request.resource.data);

      // Users can update usage history with validation
      allow update: if isAuthenticated() &&
                      isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id) &&
                      isValidUsageData(request.resource.data) &&
                      request.resource.data.vehicle_id == resource.data.vehicle_id &&
                      request.resource.data.created_by == resource.data.created_by &&
                      request.resource.data.version == resource.data.version + 1;

      // Users can delete usage history in their teams
      allow delete: if isAuthenticated() &&
                      isTeamMember(get(/databases/$(database)/documents/vehicles/$(resource.data.vehicle_id)).data.team_id);
    }
  }
}