# Firebase Configuration - DEVELOPMENT
# Copy this file to .env.development and fill in your Firebase project credentials
# Get these values from: Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_dev_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=maintainer-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=maintainer-dev
VITE_FIREBASE_STORAGE_BUCKET=maintainer-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_dev_sender_id
VITE_FIREBASE_APP_ID=your_dev_app_id
